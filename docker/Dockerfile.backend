# WildCast backend: the Flask API + the ML pipeline it serves from.
# Build from the repo root:  docker build -f docker/Dockerfile.backend -t wildcast-backend .
FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Bake a trained model into the image at build time. If real data has
# already been committed to data/cache/ -- which .github/workflows/retrain.yml
# does automatically, fetching it live from GBIF + Open-Meteo -- that real
# data is used. Otherwise (a fresh clone before retrain.yml has ever run)
# this falls back to the synthetic offline demo dataset, so the image
# always builds successfully either way. See the README's "Switching to
# real data" section.
RUN if [ -f data/cache/occurrences_yellowstone.csv ]; then \
      echo "Using committed real GBIF/Open-Meteo data from data/cache/."; \
    else \
      echo "No committed real data yet -- generating the synthetic offline demo dataset instead."; \
      python -m scripts.generate_sample_fixtures; \
    fi && \
    python -m app.ml.train

EXPOSE 8000
ENV PORT=8000
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:8000", "app.main:app"]
