# Copy to .env and fill in what you have. Everything here is optional --
# WildCast's core pipeline runs on GBIF + iNaturalist + Open-Meteo alone,
# all free and keyless (iNaturalist needs no key at all -- see
# app/services/inaturalist_client.py).

# Free instant signup, no approval wait: https://ebird.org/api/keygen
# Enables: (1) eBird as a third independent corroboration source for birds
# in "Explore Anywhere" mode, alongside GBIF and iNaturalist -- see
# app.ml.prediction_service._local_evidence_cached.
EBIRD_API_KEY=

# Free signup (approval isn't always instant): https://api.iucnredlist.org
# Enables real IUCN Red List conservation-status context (category +
# population trend) shown as a prediction factor -- the "population" signal
# requested for encounter predictions. Training-time only (see
# app/ml/train.py's _compute_conservation_status) -- skipped automatically,
# with a clear log message, when this is unset.
IUCN_API_KEY=

# Free signup: https://api.protectedplanet.net/request
PROTECTED_PLANET_API_KEY=

# Flask
PORT=8000
WILDCAST_DEBUG=1

# Accounts / auth (see README's "Accounts & saved-search alerts" section for
# the full deployment checklist, including why these matter in production).
# Signs login tokens -- generate a real random value (e.g. `openssl rand -hex 32`)
# before deploying publicly. The code falls back to an insecure, publicly-known
# dev default if this is unset, which is fine locally but NOT in production.
WILDCAST_SECRET_KEY=

# Gates POST /api/internal/check-saved-searches (the saved-search-alert
# scheduler endpoint -- see .github/workflows/check_alerts.yml). Must match
# the CRON_SECRET_KEY GitHub repo secret used by that workflow. No fallback:
# unset, that endpoint refuses every request.
CRON_SECRET_KEY=

# Where the accounts/favorites/saved-searches SQLite database lives. Default
# is backend/data/wildcast.db -- fine locally, but see README for why this
# needs to point at a persistent disk in production on Render.
WILDCAST_DB_PATH=
